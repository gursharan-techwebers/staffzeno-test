// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String    @id
  name                  String
  email                 String
  phone                 String?
  emailVerified         Boolean   @default(false)
  image                 String?
  lastPasswordChangedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  sessions Session[]
  accounts Account[]

  members     Member[]
  invitations Invitation[]
  teammembers TeamMember[]

  organizationsCreated Organization[] @relation("CreatedOrganizations")

  stripeCustomerId String?
  attendanceAudits AttendanceAudit[] @relation("AttendanceAuditUpdater")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?

  activeTeamId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String?
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id        String   @id
  name      String
  email     String?
  phone     String?
  address   String?
  slug      String
  logo      String?
  createdAt DateTime
  metadata  String?

  createdById String
  createdBy   User   @relation("CreatedOrganizations", fields: [createdById], references: [id], onDelete: Restrict)

  members            Member[]
  invitations        Invitation[]
  teams              Team[]
  attendanceSettings OrganizationAttendanceSettings?
  leaveSettings      OrganizationLeaveSettings?
  holidays           OrganizationHoliday[]
  leaves             Leave[]
  attendances        Attendance[]

  @@unique([slug])
  @@index([createdById])
  @@map("organization")
}

model OrganizationHoliday {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  date        DateTime
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, date])
  @@index([organizationId])
  @@index([date])
  @@map("organization_holiday")
}

model OrganizationAttendanceSettings {
  id             String       @id
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  timezone String

  minimumWorkingMinutes     Int
  gracePeriod               Int
  finalizationWindowMinutes Int @default(180)

  workingDays      String[]
  workingSaturdays Int[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organization_attendance_settings")
}

model OrganizationLeaveSettings {
  id             String       @id
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  monthlyPaidLeaves        Int @default(0)
  monthlyPaidHalfDayLeaves Int @default(0)
  monthlyPaidShortLeaves   Int @default(0)

  // Maximum duration of one short leave, in minutes.
  shortLeaveDuration Int @default(120)

  carryForwardEnabled    Boolean @default(false)
  leaveEncashmentEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organization_leave_settings")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role  String  @default("member")
  title String?

  customWorkingMinutes Int?

  basicSalary Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  leaves         Leave[]
  leaveBalances  LeaveBalance[]
  leaveApprovals LeaveApproval[]
  attendances    Attendance[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  title          String

  teamId String?

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

enum TeamMemberRole {
  member
  // team admin
  admin
}

model Team {
  id             String       @id
  name           String
  memberCount    Int          @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime
  updatedAt DateTime? @updatedAt

  teammembers TeamMember[]

  @@index([organizationId])
  @@map("team")
}

model TeamMember {
  id String @id

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role      TeamMemberRole @default(member)
  isPrimary Boolean        @default(false)

  membershipKey String?
  createdAt     DateTime?

  @@unique([membershipKey])
  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("teamMember")
}

model LeaveBalance {
  id String @id

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  year  Int
  month Int

  allocatedFullDayMinutes Int @default(0)
  usedFullDayMinutes      Int @default(0)

  allocatedHalfDayMinutes Int @default(0)
  usedHalfDayMinutes      Int @default(0)

  allocatedShortLeaveMinutes Int @default(0)
  usedShortLeaveMinutes      Int @default(0)

  carryForwardMinutes Int @default(0)
  adjustedMinutes     Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, year, month])
  @@index([memberId, year, month])
  @@map("leave_balance")
}

enum LeaveDuration {
  FULL_DAY
  MULTIPLE_DAYS
  HALF_DAY
  SHORT_LEAVE
}

enum HalfDayPeriod {
  FIRST_HALF
  SECOND_HALF
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Leave {
  id String @id

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  leaveType String

  startDate DateTime
  endDate   DateTime

  duration LeaveDuration

  halfDayPeriod HalfDayPeriod?

  startTime String?
  endTime   String?

  requestedMinutes Int

  reason String

  status LeaveStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvals LeaveApproval[]

  @@index([organizationId, memberId, startDate])
  @@index([organizationId, status])
  @@index([memberId, status])
  @@map("leave")
}

enum LeaveApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveApproval {
  id String @id

  leaveId String
  leave   Leave  @relation(fields: [leaveId], references: [id], onDelete: Cascade)

  approverMemberId String
  approverMember   Member @relation(fields: [approverMemberId], references: [id], onDelete: Restrict)

  status LeaveApprovalStatus @default(PENDING)

  comment String?
  actedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leaveId, approverMemberId])
  @@index([approverMemberId, status])
  @@map("leave_approval")
}

enum AttendanceStatus {
  COMPLETE
  SHORT
  ABSENT
  WEEKEND
  HOLIDAY
  INCOMPLETE
}

model Attendance {
  id String @id

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  date     DateTime
  timezone String

  requiredMinutes Int

  workedMinutes    Int @default(0)
  regularMinutes   Int @default(0)
  overtimeMinutes  Int @default(0)
  shortfallMinutes Int @default(0)

  status AttendanceStatus @default(INCOMPLETE)

  isFinalized Boolean   @default(false)
  finalizedAt DateTime?

  sessions AttendanceSession[]
  audits   AttendanceAudit[]   @relation("AttendanceAudits")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, memberId, date])
  @@index([organizationId, date])
  @@index([organizationId, status])
  @@index([memberId, date])
  @@map("attendance")
}

enum AttendanceSessionStatus {
  PUNCHED_IN
  ON_BREAK
  PUNCHED_OUT
}

enum AttendanceSessionClosedBy {
  EMPLOYEE
  SYSTEM
  ADMIN
}

model AttendanceSession {
  id String @id

  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  sessionNumber Int

  status AttendanceSessionStatus @default(PUNCHED_IN)

  punchedInAt  DateTime
  punchedOutAt DateTime?

  closedBy           AttendanceSessionClosedBy?
  warningEmailSentAt DateTime?

  totalSessionMinutes Int @default(0)
  totalBreakMinutes   Int @default(0)
  workedMinutes       Int @default(0)

  workSummary String?

  breaks AttendanceBreak[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attendanceId, sessionNumber])
  @@index([attendanceId])
  @@map("attendance_session")
}

model AttendanceBreak {
  id String @id

  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  startedAt DateTime
  endedAt   DateTime?

  durationMinutes Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([sessionId, startedAt])
  @@map("attendance_break")
}

enum AttendanceAuditAction {
  UPDATE_ATTENDANCE
}

model AttendanceAudit {
  id String @id

  attendanceId String

  attendance Attendance @relation("AttendanceAudits", fields: [attendanceId], references: [id], onDelete: Cascade)

  updatedByUserId String

  updatedByUser User @relation("AttendanceAuditUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  reason String?

  changes Json?

  createdAt DateTime @default(now())

  @@index([attendanceId, createdAt])
  @@index([updatedByUserId, createdAt])
  @@map("attendance_audit")
}
